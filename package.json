{
  "name": "startune",
  "productName": "StarTune",
  "version": "1.0.0",
  "description": "StarTune 是一款跨平台（Windows / macOS）沉浸式桌面音乐播放器，把天气电台、搜索播放、歌词舞台、粒子视觉和 3D 歌单架组合成一个更接近现场感的私人音乐空间。",
  "author": {
    "name": "StarTune Project",
    "email": "[email protected]"
  },
  "main": "desktop/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --inspect=0.0.0.0:9229",
    "check": "node --check server.js && node --check desktop/main.js && node --check desktop/preload.js && node --check desktop/overlay-preload.js && node --check dj-analyzer.js",
    "vite:build": "vite build",
    "vite:watch": "vite build --watch",
    "prebuild:win": "vite build",
    "prebuild:mac": "vite build",
    "build:win": "electron-builder --win nsis",
    "build:win:dir": "electron-builder --win dir",
    "build:mac": "electron-builder --mac dmg",
    "build:mac:dir": "electron-builder --mac dir",
    "build": "vite build && electron-builder -mwl",
    "postinstall": "node -e \"console.log('StarTune install ok. Run: npm start')\""
  },
  "build": {
    "appId": "com.startune.desktop",
    "productName": "StarTune",
    "copyright": "Copyright (c) 2026 StarTune Project",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "afterPack": "build/after-pack.js",
    "toolsets": {
      "winCodeSign": "1.1.0"
    },
    "files": [
      "desktop/**/*",
      "public/**/*",
      "build/**/*",
      "server.js",
      "dj-analyzer.js",
      "package.json",
      "!public/index.*.html",
      "public/index.html",
      "!public/css/**",
      "!src/**",
      "!index.vite.html",
      "!vite.config.js"
    ],
    "asar": false,
    "win": {
      "executableName": "StarTune",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "StarTune",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "StarTune-Setup-${version}.${ext}"
    },
    "mac": {
      "category": "public.app-category.music",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null,
      "extendInfo": {
        "NSHumanReadableCopyright": "Copyright (c) 2026 StarTune Project",
        "LSApplicationCategoryType": "public.app-category.music",
        "NSAppleEventsUsageDescription": "StarTune 需要 Apple Events 权限以响应系统快捷键。"
      }
    },
    "dmg": {
      "title": "${productName} ${version}",
      "icon": "build/icon.icns"
    }
  },
  "startune": {
    "update": {
      "provider": "generic",
      "enabled": false
    }
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "mpg123-decoder": "^1.0.3",
    "NeteaseCloudMusicApi": "^4.32.0"
  },
  "devDependencies": {
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "rcedit": "^5.0.2",
    "vite": "^8.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "GPL-3.0"
}
